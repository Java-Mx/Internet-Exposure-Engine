# Text files: exclude generic text dumps, but preserve project configs and requirements
*.txt
!requirements*.txt
!config/trusted_domains.txt

# CSV files: exclude large datasets, allow sample fixtures
*.csv
!data/*.csv
!tests/**/*.csv
!research/datasets/*.csv
