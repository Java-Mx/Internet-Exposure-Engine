# Database Configuration
# Using native SQLite (aeris.db). No external database configurations required.

# API Keys
SHODAN_API_KEY=your_shodan_api_key
CENSYS_API_ID=your_censys_api_id
CENSYS_API_SECRET=your_censys_api_secret
GITHUB_TOKEN=your_github_token
HIBP_API_KEY=your_hibp_api_key
NVD_API_KEY=your_nvd_api_key

# ── Reputation / Threat Intelligence APIs ────────────────────────────────────
# Google Safe Browsing (GSB) — Detects phishing, malware, misleading content
#   Free: 10,000 lookups/day. Get key: https://console.cloud.google.com/
#   APIs & Services → Enable "Safe Browsing API" → Credentials → API Key
GOOGLE_SAFE_BROWSING_API_KEY=your_gsb_api_key_here

# VirusTotal — URL scanned by 70+ antivirus and URL scanning engines
#   Free: 4 requests/min, 500/day. Get key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# NVD Knowledge Base
NVD_SYNC_INTERVAL_DAYS=7

# System Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_RETENTION_DAYS=365

# ML Model Configuration
MODEL_DIR=models
EMBEDDING_MODEL=all-MiniLM-L6-v2
BATCH_SIZE=32

# Risk Scoring Weights
WEIGHT_SEVERITY=0.30
WEIGHT_BREACH=0.25
WEIGHT_GRAPH=0.20
WEIGHT_ANOMALY=0.15
WEIGHT_CVE=0.10

# ── EIRPP — Exposure Intelligence & Risk Prioritization Platform ──────────────

# Layer 1: Exposure Discovery
# HIBP Domain Search requires paid subscription (free for individual email checks)
# Get key: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_hibp_api_key_here

# Layer 2: Risk Intelligence
# EPSS scores are free — no key required (https://api.first.org/data/v1/epss)

# Layer 3: Prioritization Engine
# Composite priority score weights (must sum to 1.0)
PRIORITY_W_RISK=0.35
PRIORITY_W_CRITICALITY=0.25
PRIORITY_W_EPSS=0.20
PRIORITY_W_THREAT=0.10
PRIORITY_W_COMPLIANCE=0.10

# Organisation configuration
# Override per-client in config/org_mappings.json
ORG_NAME=My Organisation
