FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Create unprivileged system user (Hardening)
RUN groupadd -g 10002 aerisui && \
    useradd -u 10002 -g aerisui -s /bin/bash -m aerisui && \
    chown -R aerisui:aerisui /app

USER aerisui

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import requests; r = requests.get('http://localhost:8501/'); exit(0 if r.status_code == 200 else 1)"

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
